# Example nginx server for the oe1ebg tools bundle. Untar the release
# tarball into the docroot (here: /srv/www/tools/, served at /tools/);
# any other directory or prefix works the same, all links are relative.
# Used as-is by CI (tests run against it), so keep it working.
server {
    listen       8080;
    server_name  _;
    root /srv/www;

    # The offline tools' data files (shared/data/*.json) are several MB raw.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;

    charset utf-8;
    charset_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;
    absolute_redirect off;

    location / {
        index index.html;
    }

    # Revalidate pages, scripts, styles and data (Cache-Control: no-cache
    # keeps the cached copy but asks the server first; an unchanged file is
    # a 304). Without it, browsers guess a lifetime from Last-Modified and
    # can mix an old and a new release after a deploy: the ADIF editor and
    # the SOTA Alerts Map have no service worker, and the PWAs (confirm,
    # notfunk) must see a new sw.js/precache.js to offer the update. The PWAs
    # answer everything else from their versioned cache, so it costs them
    # nothing. Directory URLs (…/confirm/) get it through the index redirect.
    location ~ \.(html|js|mjs|css|json)$ {
        add_header Cache-Control "no-cache";
    }
    location ~ \.webmanifest$ {
        default_type application/manifest+json;   # not in nginx's mime.types
        add_header Cache-Control "no-cache";
    }
}
