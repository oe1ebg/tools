# Example .htaccess for Apache (mod_mime, mod_headers, mod_deflate), placed
# in the directory the bundle was untarred to. Same rules as
# nginx.conf.example.
AddType application/manifest+json .webmanifest
AddDefaultCharset utf-8

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Revalidate pages, scripts, styles and data (see nginx.conf.example).
  <FilesMatch "\.(html|js|mjs|css|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
