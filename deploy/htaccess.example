# Example .htaccess for Apache (mod_mime, mod_headers, mod_deflate), placed
# in the directory the bundle was untarred to. Same rules as
# nginx.conf.example.
AddType application/manifest+json .webmanifest
AddDefaultCharset utf-8

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "(\.webmanifest|^sw\.js|^sw-core\.js|^precache\.js|^build-info\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# Also revalidate confirm/index.html and notfunk/index.html: put
#   <FilesMatch "^index\.html$"> Header set Cache-Control "no-cache" </FilesMatch>
# into an .htaccess in confirm/ and notfunk/.
